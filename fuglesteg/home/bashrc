# If not running interactively, don't do anything

case $- in
    *i*) ;;
      *) return;;
esac

# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth

# append to the history file, don't overwrite it
shopt -s histappend

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
HISTSIZE=1000
HISTFILESIZE=2000

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# set a fancy prompt (non-color, unless we know we "want" color)
color_prompt=yes

unset color_prompt force_color_prompt

# VI Mode
set -o vi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# Zoxide support
eval "$(zoxide init bash)"

# FZF
eval "$(fzf --bash)"

SSH_ENV="$HOME/.ssh/agent-environment"
# Start SSH agent automatically on login
function start_agent {
    echo "Initialising new SSH agent..."
    /usr/bin/env ssh-agent | sed 's/^echo/#echo/' > "${SSH_ENV}"
    echo succeeded
    chmod 600 "${SSH_ENV}"
    . "${SSH_ENV}" > /dev/null
    /usr/bin/env ssh-add;
}

# Source SSH settings, if applicable

if [ -f "${SSH_ENV}" ]; then
    . "${SSH_ENV}" > /dev/null

ps -ef | grep ${SSH_AGENT_PID} | grep ssh-agent$ > /dev/null || {
    start_agent;
}
else
    start_agent;
fi

# PATH
# Prepend so our own npm-installed CLIs (e.g. tree-sitter-cli) take
# precedence over Windows-side binaries pulled in via WSL interop PATH.
PATH="$HOME/.local/bin:$PATH"


# PROMPT

set_color() {
    local fg=$1
    local bg=$2

    if [ ! -z "$bg" ]; then
        echo "\[\033[38;5;${fg}m\]"
    else
        echo "\[\033[38;5;${fg}m\033[48;5;${bg}m\]"
    fi
}

export -f set_color

host_color=10

case $(hostname -s) in
    EPC-5CG3214891*)
        host_color=193
        ;;
    K80*)
        host_color=161
        ;;
    K8*)
        host_color=203
        ;;
esac

host_color=$(set_color $host_color)
user_color=$(set_color 10)
grey=$(set_color 246)
guix_color=$(set_color 214)
yellow=$(set_color 222)
blue=$(set_color 75)
white=$(set_color 254)

color_path() {
    local path="${PWD/$HOME/~}"
    local current_dir="${path##*/}"
    local parent_dir="${path%/*}"

    echo "${parent_dir}/${blue}${current_dir}"
}

export -f color_path

PS1="${user_color}\u${white}@${host_color}\h\[\033[00m\]:${blue}\w${guix_color}${GUIX_ENVIRONMENT:+ []}\[\033[00m\]\$ "
trap 'echo -ne "\033]0;${PWD}: (${BASH_COMMAND})\007"' DEBUG

# Watch status titles
#
# Sets the pane title (OSC 0, same mechanism as the DEBUG trap above) based
# on a watch command's output, so build windows show their current status
# (building / ready / errored) via tmux's automatic-rename (see tmux.conf,
# automatic-rename-format = "#{pane_title}") instead of just the program name.
_watch_title() {
    local label="$1" building_re="$2" ready_re="$3" error_re="$4"
    shift 4

    # Turn off job control for this pipeline: watch commands often take a
    # moment to shut down after the first Ctrl-C (graceful shutdown), and
    # with monitor mode on bash tracks it as a background job and later
    # dumps its reconstructed source as a job-completion notice.
    set +m
    "$@" 2>&1 | while IFS= read -r line; do
        echo "$line"
        if [[ "$line" =~ $error_re ]]; then
            printf '\033]0;❌ %s\007' "$label"
        elif [[ "$line" =~ $ready_re ]]; then
            printf '\033]0;✅ %s\007' "$label"
        elif [[ "$line" =~ $building_re ]]; then
            printf '\033]0;🔨 %s\007' "$label"
        fi
    done
    local status="${PIPESTATUS[0]}"
    set -m

    return "$status"
}

# Csharp
dotnet-run() {
    local project="$1"
    if [ -z "$project" ]; then
        project=$(basename $PWD)
    fi

    # dotnet watch prints a benign "❌ Failed to read '...staticwebassets...'"
    # even on a clean run, so error detection keys off actual build failures
    # rather than any ❌ line.
    _watch_title "$project" \
        'dotnet watch 🔄|Determining projects to restore' \
        'Application started\. Press Ctrl\+C to shut down\.|C# and Razor changes applied' \
        'Build FAILED|error CS[0-9]|Unable to apply changes due to compilation errors|Fix the error to continue' \
        dotnet watch --non-interactive run --property:WarningLevel=0 /clp:ErrorsOnly --project "$project"
}

# JS
npm-watch() {
    local label="${1:-$(basename "$PWD")}"

    # Tuned for `webpack --watch --progress`. Only the setup/building/sealing/
    # emitting phases count as "building" — webpack keeps emitting progress
    # lines for cache/idle bookkeeping right after a successful build too,
    # and those shouldn't flip the title back from ready.
    _watch_title "$label" \
        '\[webpack\.Progress\] [0-9]+% (setup|building|sealing|emitting)' \
        'compiled (successfully|with [0-9]+ warning)' \
        'compiled with [0-9]+ error' \
        npm run watch
}

dotnet-test() {
    dotnet test --filter=FullyQualifiedName~$1
}

mux() {
    local session_name=$(basename $PWD)
    session_name=$(echo $session_name | sed 's/\./_/')

    if ! tmux has-session -t "$session_name" 2> /dev/null; then
        tmux new-session -ds "$session_name" -c "$PWD" -n "$session_name"
    fi

    tmux attach-session -t "$session_name"
}

guix-run() {
    guix shell $1 -- $@
}

sbcl-micros-server() {
    local port=$1
    local create_server_args=":dont-close t"
    if ! [ -z $port ]; then
        create_server_args="$create_server_args :port $port"
    fi

    sbcl --eval "(require :asdf)" \
        --eval "(asdf:load-system :micros)" \
        --eval "(micros:create-server $create_server_args)"
}
